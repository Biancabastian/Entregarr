<%- include('../partials/header') %>

<%- include('../partials/menu') %>

<main class="container py-4">

    <div class="card shadow-sm">

        <div class="card-header bg-success text-white">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <h4 class="mb-0">
                    <i class="bi bi-tags"></i>
                    Categorias
                </h4>

                <a href="/admin/categorias/form-cadastrar" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    Nova categoria
                </a>

            </div>
        </div>

        <div class="card-body">

            <% if (categorias.length === 0) { %>

                <div class="text-center py-4">
                    <i class="bi bi-tags display-4 text-secondary"></i>
                    <h5 class="mt-3">Nenhuma categoria cadastrada</h5>
                    <p class="text-muted">Cadastre uma categoria para organizar os produtos da loja.</p>
                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>Descrição</th>
                                <th>Ações</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% categorias.forEach(categoria => { %>

                                <tr>

                                    <td><%= categoria.id %></td>

                                    <td>
                                        <strong><%= categoria.nome %></strong>
                                    </td>

                                    <td>
                                        <%= categoria.descricao || 'Sem descrição' %>
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">

                                            <a href="/admin/categorias/editar/<%= categoria.id %>"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil-square"></i>
                                                Editar
                                            </a>

                                            <form
                                                action="/admin/categorias/excluir/<%= categoria.id %>"
                                                method="POST"
                                                class="d-inline"
                                                onsubmit="return confirm('Deseja excluir esta categoria?')">

                                                <button class="btn btn-outline-danger btn-sm" type="submit">
                                                    <i class="bi bi-trash"></i>
                                                    Excluir
                                                </button>

                                            </form>

                                        </div>
                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

</main>

<%- include('../partials/footer') %>
