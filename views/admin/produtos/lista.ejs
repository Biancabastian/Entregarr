<%- include('../partials/header') %>

<%- include('../partials/menu') %>

<main class="container py-4">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap gap-2">

            <h4 class="mb-0">
                <i class="bi bi-box-seam"></i> Produtos da loja
            </h4>

            <a href="/admin/produtos/form-cadastrar" class="btn btn-light btn-sm">
                <i class="bi bi-plus-circle"></i> Novo produto
            </a>

        </div>

        <div class="card-body">

            <% if (produtos.length === 0) { %>

                <div class="text-center py-5">
                    <i class="bi bi-bag display-4 text-secondary"></i>

                    <h5 class="mt-3">Ainda não há produtos cadastrados</h5>

                    <p class="text-muted">
                        Cadastre a primeira peça de roupa para começar.
                    </p>

                    <a class="btn btn-primary" href="/admin/produtos/form-cadastrar">
                        Cadastrar produto
                    </a>
                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Imagem</th>
                                <th>Produto</th>
                                <th>Categoria</th>
                                <th>Valor</th>
                                <th>Estoque</th>
                                <th>Ações</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% produtos.forEach(produto => { %>

                                <tr>

                                    <td>
                                        <%= produto.id %>
                                    </td>

                                    <td>
                                        <% if (produto.imagem) { %>

                                            <img
                                                src="/uploads/<%= produto.imagem %>"
                                                alt="<%= produto.nome %>"
                                                class="produto-thumb"
                                            >

                                        <% } else { %>

                                            <span class="text-muted">
                                                Sem imagem
                                            </span>

                                        <% } %>
                                    </td>

                                    <td>
                                        <strong>
                                            <%= produto.nome %>
                                        </strong>

                                        <% if (produto.descricao) { %>
                                            <div class="small text-muted">
                                                <%= produto.descricao %>
                                            </div>
                                        <% } %>
                                    </td>

                                    <td>
                                        <span class="badge text-bg-light">
                                            <%= produto.categoria %>
                                        </span>
                                    </td>

                                    <td>
                                        R$ <%= Number(produto.valor).toFixed(2).replace('.', ',') %>
                                    </td>

                                    <td>
                                        <%= produto.estoque %>
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">

                                            <!-- BOTÃO EDITAR -->
                                            <a
                                                href="/admin/produtos/editar/<%= produto.id %>"
                                                class="btn btn-outline-primary btn-sm"
                                            >
                                                <i class="bi bi-pencil-square"></i>
                                                Editar
                                            </a>

                                            <!-- BOTÃO EXCLUIR -->
                                            <form
                                                action="/admin/produtos/excluir/<%= produto.id %>"
                                                method="POST"
                                                onsubmit="return confirm('Deseja excluir este produto?')"
                                            >
                                                <button
                                                    class="btn btn-outline-danger btn-sm"
                                                    type="submit"
                                                >
                                                    <i class="bi bi-trash"></i>
                                                    Excluir
                                                </button>
                                            </form>

                                        </div>
                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

</main>

<%- include('../partials/footer') %>
